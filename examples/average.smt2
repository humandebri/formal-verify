(set-logic QF_BV)
(declare-const a (_ BitVec 32))
(declare-const b (_ BitVec 32))
(check-sat)
(push 1)
(define-fun wide () (_ BitVec 33) (bvadd ((_ zero_extend 1) a) ((_ zero_extend 1) b)))
(define-fun expected () (_ BitVec 32) ((_ extract 31 0) (bvlshr wide (_ bv1 33))))
(define-fun actual () (_ BitVec 32) (bvadd (bvand a b) (bvlshr (bvxor a b) (_ bv1 32))))
(assert (not (= expected actual)))
(check-sat)
(pop 1)
